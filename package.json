{
  "displayName": "Feeder Robot",
  "name": "homebridge-feeder-robot",
  "version": "1.0.0",
  "description": "Whisker Feeder Robot Plugin for Apple HomeKit via Homebridge",
  "license": "Apache-2.0",
  "author": "syko9000",
  "repository": {
    "type": "git",
    "url": "https://github.com/syko9000/Homebridge-Feeder-Robot.git"
  },
  "bugs": {
    "url": "https://github.com/syko9000/Homebridge-Feeder-Robot/issues"
  },
  "engines": {
    "node": ">=18.17.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "keywords": [
    "homebridge-plugin",
    "whisker",
    "feeder-robot",
    "pet-feeder",
    "cat-feeder"
  ],
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "test:auth": "ts-node --transpile-only scripts/test-auth.ts",
    "test:api": "ts-node --transpile-only scripts/test-api.ts",
    "test:snack": "ts-node --transpile-only scripts/test-snack.ts"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.12",
    "axios": "^1.5.0",
    "graphql-ws": "^5.16.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^18.16.20",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.45.0",
    "homebridge": "^1.6.0",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  }
}